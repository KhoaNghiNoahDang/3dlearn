# Static production image for the React/Vite app and legacy simulations.
# Build context must be the repository root:
#   docker build -f infra/docker/Dockerfile.static .

FROM node:22-alpine AS build

WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci

COPY app ./app
COPY cell/public ./cell/public
COPY content ./content
COPY courses ./courses
COPY covers ./covers
COPY scripts ./scripts
COPY catalog.json vite.config.ts tsconfig.json ./

RUN npm run build

FROM nginx:1.27-alpine AS runtime

LABEL org.opencontainers.image.title="3dlearn-static"
LABEL org.opencontainers.image.description="3D SGK learning library static web and legacy simulations"

COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf

# Vite emits the app entry under dist/app. Keep the other hashed assets at
# the dist root, because app/index.html references them with /assets/... .
COPY --from=build /workspace/dist/ /usr/share/nginx/html/

COPY deploy/healthz.html /usr/share/nginx/html/healthz.html
COPY deploy/version.json /usr/share/nginx/html/version.json

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --spider --quiet http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
